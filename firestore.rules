rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = signed in with Google (verified email) AND listed in admins/{email}.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // admins/{email}: managed in the Firebase console only. A user may check their own entry.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Photo documents are created only by the onPhotoUploaded Cloud Function (Admin SDK bypasses rules).
    // Everyone may read the gallery; admins may edit the name/caption and delete.
    match /photos/{photoId} {
      allow read: if true;
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['who', 'caption'])
        && request.resource.data.who is string && request.resource.data.who.size() <= 60
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200;
      allow delete: if isAdmin();
    }

    // settings/app: { uploadsEnabled: bool }
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['uploadsEnabled'])
        && request.resource.data.uploadsEnabled is bool;
    }
  }
}
